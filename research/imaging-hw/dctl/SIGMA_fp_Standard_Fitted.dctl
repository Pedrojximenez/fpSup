// SIGMA fp Standard - FITTED look (DWG/Intermediate -> sRGB display)
// Baked from _SDI0013 DWG-vs-JPG fit: 3x3 matrix + per-channel tone.
// Node values are DaVinci Intermediate. Output is sRGB DISPLAY.
// Apply as the LAST node; set that output to bypass further color mgmt
// (this LUT already produces final sRGB). NOT scene-referred.
__CONSTANT__ float MAT[9] = { 4.618160f,-2.089912f,-0.107353f,-0.611751f,3.788154f,-0.842551f,0.139723f,-2.173887f,4.374515f };
__CONSTANT__ float TR[65] = { 0.000000f,0.013634f,0.027268f,0.040081f,0.052617f,0.065885f,0.080424f,0.097608f,0.115977f,0.135416f,0.156507f,0.177634f,0.201116f,0.221770f,0.238885f,0.252309f,0.270153f,0.285606f,0.304298f,0.319797f,0.334002f,0.347521f,0.354939f,0.367675f,0.378680f,0.384904f,0.392702f,0.401010f,0.413025f,0.425529f,0.438033f,0.450537f,0.463040f,0.475544f,0.488048f,0.500551f,0.513055f,0.529740f,0.547157f,0.564574f,0.581991f,0.599408f,0.616825f,0.634242f,0.651659f,0.669076f,0.686493f,0.703910f,0.721327f,0.738744f,0.756162f,0.773579f,0.790996f,0.808413f,0.825830f,0.843247f,0.860664f,0.878081f,0.895498f,0.912915f,0.930332f,0.947749f,0.965166f,0.982583f,1.000000f };
__CONSTANT__ float TG[65] = { 0.000000f,0.012635f,0.026043f,0.043268f,0.059920f,0.076586f,0.090523f,0.105051f,0.119762f,0.134860f,0.150525f,0.171069f,0.197305f,0.223541f,0.243494f,0.262504f,0.279185f,0.294175f,0.310309f,0.327287f,0.343070f,0.358331f,0.370809f,0.382645f,0.394733f,0.405435f,0.414065f,0.422388f,0.430468f,0.438953f,0.447779f,0.456605f,0.465431f,0.474257f,0.483083f,0.491909f,0.500734f,0.509560f,0.518386f,0.527323f,0.546230f,0.565137f,0.584044f,0.602951f,0.621858f,0.640765f,0.659673f,0.678580f,0.697487f,0.716394f,0.735301f,0.754208f,0.773115f,0.792022f,0.810929f,0.829836f,0.848743f,0.867650f,0.886558f,0.905465f,0.924372f,0.943279f,0.962186f,0.981093f,1.000000f };
__CONSTANT__ float TB[65] = { 0.000000f,0.018842f,0.027863f,0.034778f,0.047994f,0.062093f,0.078579f,0.097040f,0.115502f,0.139252f,0.164480f,0.189709f,0.214937f,0.232614f,0.250003f,0.267393f,0.283330f,0.298952f,0.315684f,0.333115f,0.349995f,0.366576f,0.378427f,0.390589f,0.403395f,0.413667f,0.422851f,0.431048f,0.439198f,0.449044f,0.458992f,0.467737f,0.475941f,0.484146f,0.492350f,0.500554f,0.508759f,0.516963f,0.525167f,0.533371f,0.541576f,0.549780f,0.557984f,0.566188f,0.579499f,0.600524f,0.621549f,0.642575f,0.663600f,0.684625f,0.705650f,0.726675f,0.747700f,0.768725f,0.789750f,0.810775f,0.831800f,0.852825f,0.873850f,0.894875f,0.915900f,0.936925f,0.957950f,0.978975f,1.000000f };

__DEVICE__ float di2lin(float v) {
    if (v <= 0.02740668f) return v / 10.44426855f;
    return _exp2f(v / 0.07329248f - 7.0f) - 0.0075f;
}
__DEVICE__ float lin2srgb(float v) {
    v = _fmaxf(0.0f, _fminf(1.0f, v));
    if (v <= 0.0031308f) return v * 12.92f;
    return 1.055f * _powf(v, 1.0f/2.4f) - 0.055f;
}
__DEVICE__ float tone(__CONSTANT__ float* T, float x) {
    x = _fmaxf(0.0f, _fminf(1.0f, x));
    float fi = x * (65-1);
    int i = (int)fi; float t = fi - (float)i;
    if (i >= 65-1) return T[65-1];
    return T[i]*(1.0f-t) + T[i+1]*t;
}
__DEVICE__ float3 transform(int p_W,int p_H,int p_X,int p_Y,float p_R,float p_G,float p_B) {
    float r = di2lin(p_R)/2.124f;
    float g = di2lin(p_G)/2.124f;
    float b = di2lin(p_B)/2.124f;
    float zr = MAT[0]*r + MAT[1]*g + MAT[2]*b;
    float zg = MAT[3]*r + MAT[4]*g + MAT[5]*b;
    float zb = MAT[6]*r + MAT[7]*g + MAT[8]*b;
    float yr = tone(TR, zr);
    float yg = tone(TG, zg);
    float yb = tone(TB, zb);
    return make_float3(lin2srgb(yr), lin2srgb(yg), lin2srgb(yb));
}
