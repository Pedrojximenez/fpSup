    "WB": "0010\u201313 have exactly equal AsShotNeutral; multiplying all by its reciprocal would cancel in reported ratios, so no WB was applied",
    "registration_model_limit": "global translation only, not rotation/parallax/local object motion",
    "source_files_modified": false
  },
