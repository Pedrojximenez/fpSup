+
+/* Observe only the return of each drain transfer that already exists.  The
+ * frame logger and all drain decisions remain unchanged.  This counter is
+ * local to drain diagnostics, separate from the frame-error counter above.
+ */
+static void diagnostic_drain_log(uint32_t sequence, int iteration, int rc,
+                                 int moved, const unsigned char *bytes)
+{
+    static unsigned long long count;
+    static const char digits[] = "0123456789abcdef";
+    int saved_errno = errno;
+    struct timespec ts = { -1, -1 };
+    char hex[FRAME_SIZE * 2 + 1];
+    size_t captured = moved > 0 ? (size_t)moved : 0;
+    if (captured > FRAME_SIZE) captured = FRAME_SIZE;
+    int clock_rc = clock_gettime(CLOCK_MONOTONIC_RAW, &ts);
+    for (size_t i = 0; i < captured; i++) {
+        hex[i * 2] = digits[bytes[i] >> 4];
+        hex[i * 2 + 1] = digits[bytes[i] & 15];
+    }
+    hex[captured * 2] = 0;
+    fprintf(stderr, "FPSH_DIAG_DRAIN source=drain count=%llu seq=%u "
+            "drain_iteration=%d rc=%d moved=%d expected=%d captured=%zu "
+            "clock=MONOTONIC_RAW clock_rc=%d raw_sec=%lld raw_nsec=%ld hex=%s\n",
+            ++count, sequence, iteration, rc, moved, CMD_LINE_MAX, captured,
+            clock_rc, (long long)ts.tv_sec, ts.tv_nsec, hex);
+    errno = saved_errno;
+}
