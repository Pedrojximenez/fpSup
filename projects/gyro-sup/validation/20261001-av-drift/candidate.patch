diff --git a/gyro/gcsv_rows.S b/gyro/gcsv_rows.S
index 01241e7..0b6e230 100644
--- a/gyro/gcsv_rows.S
+++ b/gyro/gcsv_rows.S
@@ -49,6 +49,14 @@
  * more for the reading, then a newline.  Fifty-four; sixty-four with room. */
 .equ ROW_MAX,        64
 
+/* Optional scheduling diagnostic.  Keep the default and Base unchanged. */
+#if defined(FPGYRO_FORMAT_YIELD_RECORDS) && !defined(FPGYRO_EDITION_BASE)
+#if FPGYRO_FORMAT_YIELD_RECORDS < 1 || FPGYRO_FORMAT_YIELD_RECORDS > 65535
+#error FPGYRO_FORMAT_YIELD_RECORDS must be between 1 and 65535
+#endif
+#define GCSV_FORMAT_YIELD 1
+#endif
+
 /* ------------------------------------------------------------------ digits */
 
 /* Two decimal digits an entry, little-endian, so one strh emits both. */
@@ -292,6 +300,10 @@ gcsv_emit:
     .global gcsv_format
 gcsv_format:
     push    {r4, r5, r6, r7, r8, lr}
+#ifdef GCSV_FORMAT_YIELD
+    push    {r9, r10}                  @ preserve alignment at native calls
+    movw    r9, #FPGYRO_FORMAT_YIELD_RECORDS
+#endif
     mov     r4, r0
     mov     r5, r1
     mov     r6, r2
@@ -332,7 +344,20 @@ gcsv_format:
     str     r0, [r8, #8]
 
 4:  add     r4, r4, #8
+gcsv_record_consumed:
     sub     r5, r5, #1
+#ifdef GCSV_FORMAT_YIELD
+    /* No producer or media lock is held here.  Keep accumulating the same
+     * text buffer: writer_put still makes one write for the whole block. */
+    subs    r9, r9, #1
+    bne     1b
+    mov     r0, #1                     @ zero is not a scheduler yield
+    movw    ip, #:lower16:TK_DLY_TSK
+    movt    ip, #:upper16:TK_DLY_TSK
+gcsv_format_delay:
+    blx     ip
+    movw    r9, #FPGYRO_FORMAT_YIELD_RECORDS
+#endif
     b       1b
 
 2:  /* Send the held row out with no reading, if there is one. */
@@ -352,6 +377,9 @@ gcsv_format:
 
 9:  mov     r0, r6
     mov     r1, r5                      @ what is left, not what was taken
+#ifdef GCSV_FORMAT_YIELD
+    pop     {r9, r10}
+#endif
     pop     {r4, r5, r6, r7, r8, lr}
     bx      lr
 
