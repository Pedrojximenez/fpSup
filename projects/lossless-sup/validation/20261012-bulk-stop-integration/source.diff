+        self.assertEqual(len(r.buffers), 1)
+        self.assertEqual(r.get(MGR + 0x18C), 0)
+
+    def test_sequential_duplicate_release_is_noop(self):
+        r = Flush()
+        parent = r.node(0, refs=1, raw_refs=1)
+        child = r.node(1, parent=0, raw_slot=0)
+        r.queue([child])
+        r.invoke(r0=OBJ)
