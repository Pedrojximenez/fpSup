+        r.queue([queued])
+        r.invoke(r0=OBJ)
+        self.assertEqual(r.returned, [queued])
+        self.assertEqual(r.buffers, [])
+        self.assertEqual((r.get(parent + 0x1110), r.get(parent + 0x1114)), (1, 1))
+        self.assertEqual(r.get(MGR + 4), parent)
