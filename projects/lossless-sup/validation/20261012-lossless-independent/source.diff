+
+class ModuleCompatibilityTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        # Reuse setup/helpers, without inheriting/re-running all LOSS tests.
+        V.LosslessV3Tests.setUpClass.__func__(cls)
+
+    boot = V.LosslessV3Tests.boot
+    outcome = V.LosslessV3Tests.outcome
+    stock = V.LosslessV3Tests.stock
+
+    def assert_coexists(self, cam, name):
+        self.assertEqual(self.outcome(cam, name), 'LOADED')
+        self.assertEqual(self.outcome(cam), 'LOADED')
+        self.assertEqual(cam.w(SITE), PATCH)
+        self.assertEqual(sorted(a for a, _, _ in cam.journal()), sorted([*V.SITES, SITE]))
+
+    def test_lossless_alone_does_not_claim_or_modify_the_stop_site(self):
+        cam = self.boot()
+        self.assertEqual(self.outcome(cam), 'LOADED')
+        self.assertNotIn(SITE, V.SITES)
+        self.assertNotIn(SITE, [a for a, _, _ in cam.journal()])
+        self.assertEqual(cam.w(SITE), STOCK)
+
+    def test_both_load_orders_and_power_off(self):
+        for name in ('05STOPFX.BIN', '15STOPFX.BIN'):
+            with self.subTest(name=name):
+                cam = self.boot((name, stopfix_sup()))
+                self.assert_coexists(cam, name)
+                cam.power_off()
+                for site in (*V.SITES, SITE):
+                    self.assertEqual(cam.w(site), self.stock(site), hex(site))
+
+    def test_stopfix_repairs_its_own_stale_word(self):
+        cam = self.boot(('05STOPFX.BIN', stopfix_sup()), stale={SITE: PATCH})
+        self.assert_coexists(cam, '05STOPFX.BIN')
+        self.assertIn(SITE, {a for kind, a, _, _ in cam.log() if kind == 'REPAIRED'})
+
+    def test_mutation_reintroducing_stop_claim_is_detected(self):
+        sup = bytearray(self.sup)
+        at = V.B.SL_HEADER_LEN + self.sym['claims'] + 4
+        for i in range(V.L.SITE_COUNT):
+            if struct.unpack_from('<I', sup, at + 12 * i)[0] == V.BULK_GATE:
+                struct.pack_into('<3I', sup, at + 12 * i, SITE, STOCK, 2)
+                break
+        else:
+            self.fail('bulk gate claim missing')
+        cam = self.boot(('05STOPFX.BIN', stopfix_sup()), sup=bytes(sup))
+        with self.assertRaises(AssertionError):
+            self.assert_coexists(cam, '05STOPFX.BIN')
+        self.assertEqual(self.outcome(cam), 'RELEASED')
+
