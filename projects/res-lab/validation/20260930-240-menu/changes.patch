+.syntax unified
+.arm
+.text
+/* Native frame-rate glue. Each ROLE is an independent leaf trampoline.
+ * Guards use published CUSTOM + CinemaDNG state; no firmware call or BSS writes.
+ * Preserve NZCVQ and scratch registers around the displaced instruction.
+ */
+.macro LDA reg, value
+ movw \reg, #:lower16:\value
+ movt \reg, #:upper16:\value
+.endm
+.macro RETURN_TO address
+ ldr pc, [pc, #-4]
+ .word \address
+.endm
+.global entry
+entry:
+#if ROLE == 5
+ /* The native lazy cache may already exist before AutoRun. Return owned data. */
+ LDA r0, LEGAL_DESC
+ RETURN_TO 0xC00A885C
+#else
+ push {r1,r2,r3,ip}
+ mrs r2,cpsr
+#if ROLE == 1
+ mov r0,r1
+#endif
+ LDA r3, FLAG
+ ldr r3,[r3]
+ cmp r3,#1
+ bne stock
+ LDA r3, FMTLATCH
+ ldr r3,[r3]
+ cmp r3,#0
+ bne stock
+#if ROLE == 1
+ mov r0,#0
+#elif ROLE == 2
+ /* r1 is restored below, so save the selected comparison operand in its slot. */
+ str r6,[sp]
+#else
+ LDA r3, LIST
+ str r3,[r0]
+ mov r3,#10
+ str r3,[r0,#4]
+ msr cpsr_f,r2
+ pop {r1,r2,r3,ip}
+ bx lr
+#endif
+ b done
+stock:
+#if ROLE == 2
+ str r4,[sp]
+#elif ROLE == 3
+ msr cpsr_f,r2
+ pop {r1,r2,r3,ip}
+ push {r4,r5,lr}
+ RETURN_TO 0xC049A78C
+#elif ROLE == 4
+ msr cpsr_f,r2
+ pop {r1,r2,r3,ip}
+ sub sp,sp,#8
+ RETURN_TO 0xC05332AC
+#endif
+done:
+ msr cpsr_f,r2
+ pop {r1,r2,r3,ip}
+#if ROLE == 1
+ RETURN_TO 0xC04A1220
+#elif ROLE == 2
+ RETURN_TO 0xC00A87E8
+#endif
+
+#endif
